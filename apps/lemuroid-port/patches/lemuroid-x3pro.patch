+
+        val result =
+            GLRetroView(context, currentState.retroViewData)
+                .apply {
+                    isFocusable = false
+                    isFocusableInTouchMode = false
+                }
+
+        if (!system.hasTouchScreen) {
+            result.disableTouchEvents()
