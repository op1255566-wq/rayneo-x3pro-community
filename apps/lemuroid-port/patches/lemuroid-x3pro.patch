+            ) == PackageManager.PERMISSION_GRANTED
+
+        val enableMicrophone = systemCoreConfig.supportsMicrophone && hasMicrophonePermission
+
+        val loadingStatesFlow =
+            gameLoader.load(
+                applicationContext,
+                game,
+                requestLoadSave && autoSaveEnabled,
+                systemCoreConfig,
+                directLoad,
+            )
+
+        loadingStatesFlow
